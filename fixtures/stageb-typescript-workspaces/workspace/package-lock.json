{
  "name": "deploom-stageb-workspace-replay",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "deploom-stageb-workspace-replay",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@deploom-stageb/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/@deploom-stageb/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@deploom-stageb/domain": {
      "resolved": "packages/domain",
      "link": true
    },
    "packages/app": {
      "name": "@deploom-stageb/app",
      "version": "1.0.0",
      "dependencies": {
        "@deploom-stageb/contracts": "1.0.0",
        "@deploom-stageb/domain": "1.0.0"
      }
    },
    "packages/contracts": {
      "name": "@deploom-stageb/contracts",
      "version": "1.0.0"
    },
    "packages/domain": {
      "name": "@deploom-stageb/domain",
      "version": "1.0.0",
      "dependencies": {
        "@deploom-stageb/contracts": "1.0.0"
      }
    }
  }
}
